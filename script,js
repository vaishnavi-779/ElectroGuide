hydrateElectroGuideDetails(categories);
function openComponent(name,parent){let u="component.html?name="+encodeURIComponent(name);if(parent)u+="&parent="+encodeURIComponent(parent);location.href=u;}
function showCategory(key){if(categories[key])location.href="component.html?category="+encodeURIComponent(key);}
function buildSearchIndex(){const a=[];Object.values(categories).forEach(c=>c.items.forEach(id=>{const d=electroGuideDetails[id]||electroGuideInternalDetails[id];a.push({id,name:d?.name||titleFromSlugForData(id),category:d?.category||c.name,description:d?.description||"Electronics component",keywords:`${id} ${d?.name||""} ${c.name} ${d?.description||""}`.toLowerCase()})}));return a}const electroGuideSearchIndex=buildSearchIndex();
function renderSearchResults(q){const box=document.getElementById("search-results");if(!box)return;q=q.trim().toLowerCase();if(!q){box.innerHTML="";box.classList.remove("visible");return}const m=electroGuideSearchIndex.filter(x=>x.keywords.includes(q)).slice(0,10);box.innerHTML=m.length?m.map(x=>`<button class="search-result" type="button" onclick="openComponent('${x.id}')"><strong>${x.name}</strong><small>${x.category}</small><span>${x.description}</span></button>`).join(""):"<div class=\"search-empty\">No component found. Try resistor, Arduino, ESP32, sensor, motor, diode or IC.</div>";box.classList.add("visible")}
document.querySelectorAll(".category[data-category]").forEach(b=>b.addEventListener("click",()=>showCategory(b.dataset.category)));const s=document.getElementById("global-search-input");if(s){s.addEventListener("input",()=>renderSearchResults(s.value));s.addEventListener("keydown",e=>{if(e.key==="Enter")document.querySelector(".search-result")?.click()})}document.addEventListener("click",e=>{if(!e.target.closest(".global-search"))document.getElementById("search-results")?.classList.remove("visible")});
