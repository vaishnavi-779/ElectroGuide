function addInternalHardware(){const common=(id,name,description)=>({id:id+"-"+name.toLowerCase().replace(/[^a-z0-9]+/g,"-"),name,description});const templates={"esp32":[{id:"esp32-soc",name:"ESP32 SoC / MCU",description:"Main dual-core microcontroller providing processing, GPIO, Wi-Fi, Bluetooth, ADC, DAC, timers and communication peripherals."},{id:"esp32-wroom",name:"ESP32-WROOM Module",description:"Shielded module containing the ESP32 SoC, memory and RF circuitry on common development boards."},{id:"esp32-flash",name:"SPI Flash Memory",description:"Non-volatile memory used for firmware, program data and application resources."},{id:"esp32-crystal",name:"40 MHz Crystal Oscillator",description:"Clock reference used by the ESP32 system and radio circuitry."},{id:"esp32-antenna",name:"PCB Antenna",description:"Printed antenna used for 2.4 GHz wireless communication on boards with an onboard antenna."},{id:"esp32-usb-uart",name:"USB-to-UART Bridge",description:"Converts USB data from the computer to UART serial data used to program and communicate with the ESP32 on typical DevKit boards."},{id:"esp32-regulator",name:"3.3 V Voltage Regulator",description:"Converts board input power to the regulated 3.3 V rail required by the ESP32."},{id:"esp32-boot",name:"BOOT Button",description:"Places the ESP32 into firmware download mode when used with the EN/reset control."},{id:"esp32-en",name:"EN / Reset Button",description:"Resets or enables the ESP32 module."},{id:"esp32-power-led",name:"Power LED",description:"Indicates that board power is present."},{id:"esp32-headers",name:"GPIO Pin Headers",description:"Expose GPIO, power and peripheral signals for external circuits."},{id:"esp32-decoupling",name:"Decoupling Capacitors",description:"Smooth local supply voltage and reduce high-frequency power noise."}],"esp8266":["ESP8266 SoC","SPI Flash","Crystal Oscillator","Wi-Fi RF Section","PCB Antenna","3.3 V Regulator","USB-to-UART Bridge","Reset/Boot Circuit","GPIO Headers"],"arduino-nano":["ATmega328P MCU","USB Interface","16 MHz Clock","5 V Regulator","USB Connector","Reset Circuit","Power LED","GPIO Headers","Resistors & Capacitors"],"arduino-mega":["ATmega2560 MCU","ATmega16U2 USB Interface","16 MHz Clock","Voltage Regulators","USB Connector","Reset Circuit","Power LED","TX/RX LEDs","GPIO Headers"],"arduino-pro-mini":["ATmega328P MCU","16 MHz Clock","Voltage Regulator","Reset Circuit","Power LED","GPIO Headers","Decoupling Capacitors"],"esp32-cam":["ESP32 SoC","Camera Connector","OV2640 Camera Interface","SPI Flash","3.3 V Regulator","Wi-Fi/Bluetooth RF Section","PCB Antenna","MicroSD Interface","GPIO Headers"],"nodemcu":["ESP8266 Module","USB-to-UART Bridge","3.3 V Regulator","Flash Memory","PCB Antenna","Reset/Flash Buttons","Power LED","GPIO Headers"],"stm32":["STM32 MCU","Flash Memory","SRAM","Clock Oscillator","Voltage Regulator","Reset Circuit","Debug Interface","GPIO Headers","Decoupling Capacitors"],"stm32-blue-pill":["STM32F103C8T6 MCU","8 MHz Crystal","32.768 kHz Crystal","3.3 V Regulator","USB Connector","Reset Circuit","BOOT Pins","GPIO Headers"],"stm32-nucleo":["STM32 MCU","ST-LINK Debugger","USB Connector","Clock Source","Power Regulation","User LED","User Button","Arduino-compatible Headers","Morpho Headers"],"rp2040":["RP2040 MCU","Dual-core ARM Cortex-M0+","QSPI Flash","12 MHz Crystal","Voltage Regulator","USB Interface","BOOTSEL Circuit","GPIO Headers"],"raspberry-pi-pico":["RP2040 MCU","QSPI Flash","12 MHz Crystal","3.3 V Regulator","USB Interface","BOOTSEL Button","Power LED","GPIO Headers"],"atmega328p":["AVR CPU Core","Flash Memory","SRAM","EEPROM","Timers/Counters","ADC","USART/SPI/I2C Peripherals","GPIO Ports","Clock Oscillator"],"atmega2560":["AVR CPU Core","Flash Memory","SRAM","EEPROM","ADC","Timers","USART Interfaces","SPI/I2C","GPIO Ports","Clock Oscillator"],"attiny85":["AVR CPU Core","Flash Memory","SRAM","EEPROM","ADC","Timers","GPIO Pins","Clock Source"],"pic16f877a":["PIC CPU Core","Flash Program Memory","RAM","EEPROM","ADC","Timers","USART","SPI/I2C","GPIO Ports","Oscillator Circuit"],"pic18":["PIC18 CPU Core","Flash Memory","RAM","EEPROM","Timers","ADC","Communication Peripherals","GPIO Ports","Oscillator"],"8051":["8051 CPU Core","Program Memory","RAM","Timers/Counters","Serial Port","Interrupt Controller","GPIO Ports","Oscillator"],"msp430":["MSP430 CPU Core","Flash Memory","RAM","Timers","ADC","Low-power Clock System","GPIO","Serial Interfaces"]};Object.keys(templates).forEach(id=>{const d=electroGuideDetails[id];if(!d)return;const list=templates[id];d.internalComponents=list.map(x=>typeof x==="string"?common(id,x,`${x} is a functional hardware block used inside or alongside ${d.name}.`):x);d.internalComponents.forEach(x=>{electroGuideInternalDetails[x.id]={name:x.name,category:`Inside ${d.name}`,description:x.description,facts:[["Parent",d.name],["Role","Internal hardware block"]],sections:{"What does it do?":x.description,"Why is it used?":`It is part of the hardware architecture that allows ${d.name} to operate, communicate or interface with external circuits.`}}})});categories.microcontrollers.items.forEach(id=>{const d=electroGuideDetails[id];if(!d||d.internalComponents)return;d.internalComponents=[common(id,"Main MCU / Processor",`The processing device that executes firmware for ${d.name}.`),common(id,"Memory","Program and working memory used by the controller."),common(id,"Clock / Oscillator","Provides timing for processor and peripherals."),common(id,"Power Regulation","Provides regulated power to the controller and board."),common(id,"GPIO / Pin Headers","Expose digital, analog and peripheral signals."),common(id,"Reset / Boot Circuit","Controls startup, reset and programming modes where supported."),common(id,"Decoupling Capacitors","Help stabilize local power rails and reduce supply noise.")];d.internalComponents.forEach(x=>{electroGuideInternalDetails[x.id]={name:x.name,category:`Inside ${d.name}`,description:x.description,facts:[["Parent",d.name],