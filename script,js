function openComponent(componentName) {
    window.location.href = "component.html?name=" + encodeURIComponent(componentName);
}

function showCategory(categoryKey) {
    if (!categories[categoryKey]) return;
    window.location.href = "component.html?category=" + encodeURIComponent(categoryKey);
}

function renderSearchResults(query) {
    const box = document.getElementById("search-results");
    if (!box || typeof electroGuideSearchIndex === "undefined") return;
    const q = query.trim().toLowerCase();
    if (!q) { box.innerHTML = ""; box.classList.remove("visible"); return; }
    const matches = electroGuideSearchIndex.filter(item => `${item.name} ${item.category} ${item.description} ${item.keywords}`.toLowerCase().includes(q)).slice(0, 8);
    box.innerHTML = matches.length ? matches.map(item => `<button type="button" class="search-result" onclick="openComponent('${item.id}')"><strong>${item.name}</strong><small>${item.category}</small></button>`).join("") : `<div class="search-empty">No component found. Try another electronics term.</div>`;
    box.classList.add("visible");
}

const categoryButtons = document.querySelectorAll(".category[data-category]");
categoryButtons.forEach(button => button.addEventListener("click", () => showCategory(button.dataset.category)));

const globalSearchInput = document.getElementById("global-search-input");
if (globalSearchInput) {
    globalSearchInput.addEventListener("input", () => renderSearchResults(globalSearchInput.value));
    globalSearchInput.addEventListener("keydown", event => {
        if (event.key === "Enter") {
            const first = document.querySelector(".search-result");
            if (first) first.click();
        }
    });
}

document.addEventListener("click", event => {
    if (!event.target.closest(".global-search")) {
        const box = document.getElementById("search-results");
        if (box) box.classList.remove("visible");
    }
});
