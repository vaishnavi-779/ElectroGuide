function openComponent(componentName) {
    window.location.href = "component.html?name=" + encodeURIComponent(componentName);
}

function showCategory(categoryKey) {
    const category = categories[categoryKey];
    if (!category) return;

    const params = new URLSearchParams();
    params.set("category", categoryKey);
    window.location.href = "component.html?" + params.toString();
}

const categoryButtons = document.querySelectorAll(".category[data-category]");
categoryButtons.forEach(button => {
    button.addEventListener("click", () => {
        showCategory(button.dataset.category);
    });
});
